{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptBridge",
  "version": "0.1.0",
  "identifier": "com.vibecode.router",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PromptBridge",
        "width": 900,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "protocols": [
      {
        "name": "vibecode",
        "role": "viewer"
      }
    ]
  }
}
