{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "VibeCode Router",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.vibecode.router",
      "targets": "all",
      "protocols": [
        {
          "name": "vibecode",
          "role": "viewer"
        }
      ]
    },
    "windows": [
      {
        "title": "VibeCode Router",
        "width": 900,
        "height": 600
      }
    ]
  }
}
